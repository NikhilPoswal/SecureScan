# Environment variables template for SecureScan
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.

# Flask secret key — REQUIRED in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Set this in Vercel Dashboard → Settings → Environment Variables too.
SECRET_KEY=your_random_32_byte_hex_here

# Vercel deployment credentials (only required if deploying via custom REST script)
VERCEL_TOKEN=your_token_here
VERCEL_PROJECT_ID=your_project_id_here
VERCEL_TEAM_ID=your_team_id_here

# ── Batch 1: Database (Neon Postgres) ────────────────────────────────────────
# Provision a free Neon database at https://console.neon.tech
# Copy the "Connection string" from the project dashboard.
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Set this in Vercel Dashboard → Settings → Environment Variables too (all environments).
DATABASE_URL=postgresql://your_user:your_password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
