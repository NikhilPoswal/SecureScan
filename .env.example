# Environment variables template for SecureScan
# Copy this file to .env and fill in your values.

# Flask secret key (optional in dev, recommended in production)
SECRET_KEY=your_random_secret_key_here

# Vercel deployment credentials (only required if deploying via custom REST script)
VERCEL_TOKEN=your_token_here
VERCEL_PROJECT_ID=your_project_id_here
VERCEL_TEAM_ID=your_team_id_here
